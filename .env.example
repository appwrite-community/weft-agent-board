# Appwrite project (Console > Overview > Integrations > API keys)
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=<PROJECT_ID>
APPWRITE_API_KEY=<API_KEY>

# OpenRouter key for the agent function. The provision script stores it as a secret function variable.
OPENROUTER_API_KEY=<OPENROUTER_API_KEY>
# Optional: any OpenRouter model that supports tool calling.
OPENROUTER_MODEL=openai/gpt-6-luna

# Password for the four demo accounts that the seed script creates
DEMO_PASSWORD=<AT_LEAST_8_CHARACTERS>

# Web app (Vite exposes only VITE_ variables to the browser)
VITE_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=<PROJECT_ID>
